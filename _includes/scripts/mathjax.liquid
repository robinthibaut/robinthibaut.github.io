{% if site.enable_math and site.third_party_libraries.mathjax.url.js %}
  {% unless page.pseudocode %}
    <!-- MathJax -->
    <script type="text/javascript">
      window.MathJax = {
        tex: {
          tags: 'ams',
        },
      };
    </script>
    <script
      defer
      type="text/javascript"
      id="MathJax-script"
      src="{{ site.third_party_libraries.mathjax.url.js }}"
      integrity="{{ site.third_party_libraries.mathjax.integrity.js }}"
      crossorigin="anonymous"
    ></script>
    {% if site.third_party_libraries.polyfill.url.js %}
      <script
        defer
        src="{{ site.third_party_libraries.polyfill.url.js }}"
        crossorigin="anonymous"
      ></script>
    {% endif %}
  {% endunless %}
{% endif %}
